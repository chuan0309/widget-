{
  "name": "glass-widgets",
  "productName": "Glass Widgets",
  "version": "1.0.0",
  "description": "Windows 11 桌面玻璃小組件 + 藍牙連線通知",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.glasswidgets.app",
    "productName": "Glass Widgets",
    "files": [
      "main.js",
      "preload.js",
      "pinterest-api.js",
      "wallpaper.js",
      "calendar.js",
      "google.js",
      "cwa.js",
      "phone-push.js",
      "hue.js",
      "oauth.json",
      "helper.ps1",
      "locate.ps1",
      "renderer/**",
      "assets/**",
      "matter-home.js",
      "!**/node_modules/@matter/*/src/**",
      "!**/node_modules/@project-chip/*/src/**",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/@matter/*/dist/esm/**",
      "!**/node_modules/@project-chip/*/dist/esm/**"
    ],
    "asarUnpack": [
      "helper.ps1",
      "locate.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Glass-Widgets-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chuan0309",
        "repo": "widget-",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Glass-Widgets-Portable-${version}.${ext}"
    }
  },
  "author": "Chuan",
  "dependencies": {
    "electron-updater": "6.8.11",
    "@matter/main": "0.18.1",
    "@project-chip/matter.js": "0.18.1"
  }
}
